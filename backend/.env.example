PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusfind?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/campusfind
# (If omitted, automatic in-memory MongoDB starts for dev)
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=campusfind_jwt_super_secret_key_2024
JWT_EXPIRES_IN=30d

# Cloudinary Image Upload (Optional - Local storage is used if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
